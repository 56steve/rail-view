# Used by docker-compose.yml's backend service (env_file). DATABASE_URL
# and REDIS_URL are already overridden inline in docker-compose.yml for
# the container-network hostnames - this file is only for values you
# want to override beyond that (e.g. SIMULATED_TRAIN_COUNT).
SIMULATED_TRAIN_COUNT=6
SIMULATION_TICK_SECONDS=1.0
