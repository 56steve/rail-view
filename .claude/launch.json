{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "railpulse-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "3010"],
      "port": 3010
    },
    {
      "name": "railpulse-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
